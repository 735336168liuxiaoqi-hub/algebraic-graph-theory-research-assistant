# Preserve the baseline's bytes and mixed historical line endings on checkout.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.exe binary
*.zip binary
*.png binary
*.pdf binary
# Windows command launchers need native line endings.
start-desktop.cmd text eol=crlf
start-assistant.cmd text eol=crlf
start-offline.cmd text eol=crlf
tools/start-cli.cmd text eol=crlf
